"Hidden Bar needs Accessibility access to hide icons." = "Hidden Bar’ın simgeleri gizleyebilmesi için Erişilebilirlik erişimi gerekir.";
"Open Settings…" = "Ayarlar’ı Aç…";
"Expand the bar when the pointer rests on the menu bar" = "İşaretçi menü çubuğunda beklediğinde çubuğu genişlet";
